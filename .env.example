# 对话模型（OpenAI 兼容接口）
# OpenCode Go 可用：https://opencode.ai/inference/go/openai/v1
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 可选：为上游追加自定义请求头（JSON）
# OpenCode Go 的 x-opencode-session 已按域名自动处理，无需重复配置
# UPSTREAM_HEADERS={"X-Example":"value","X-Session":"{sessionId}"}

# 向量化模型（OpenAI 兼容接口）
EMBED_API_KEY=sk-your-key
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-large-zh-v1.5

# 文档分块策略：markdown | plain | fixed
CHUNK_STRATEGY=markdown

# 后端监听端口
PORT=3001

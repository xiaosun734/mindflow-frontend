{
  "name": "mindflow-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "dev:all": "concurrently -n web,api -c blue,green \"pnpm dev\" \"pnpm dev:server\"",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "openai": "^6.42.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.34",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.12",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.2.8"
  }
}
